# SPAgo local environment configuration.
# Copy to .env and adjust as needed. Never commit real secrets.

# --- PostgreSQL (docker compose wires these into the db service) ---
POSTGRES_USER=spago
POSTGRES_PASSWORD=spago
POSTGRES_DB=spago
# Port exposed on the host by the db container
SPAGO_DB_PORT=5432

# --- Backend (app container; defaults are already correct for compose) ---
# SQLAlchemy URL used inside the app container.
SPAGO_DATABASE_URL=postgresql+psycopg://spago:spago@db:5432/spago
# Directory holding fixture Parquet files (baked into the app image).
SPAGO_FIXTURE_DIR=/app/data/fixtures
# Directory holding versioned SQL migrations (baked into the app image).
SPAGO_MIGRATIONS_DIR=/app/migrations
# Directory for cached molecule depictions (mounted as a volume).
SPAGO_DEPICTION_CACHE_DIR=/app/data/cache/depictions
SPAGO_DEFAULT_PAGE_SIZE=100
SPAGO_MAX_PAGE_SIZE=500
# Comma-separated CORS origins for local development.
SPAGO_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Frontend: base URL of the backend API (build-time default "/api/v1" via Vite proxy in dev).
VITE_API_BASE_URL=/api/v1

# --- LLM endpoint (optional; all three unset → offline extractive summaries) ---
# The base URL carries the FULL API prefix (usually including the version
# segment); SPAgo appends exactly /chat/completions. Plain http is only
# accepted for loopback/private-network endpoints. Leave SPAGO_LLM_API_KEY
# empty for unauthenticated local endpoints (no Authorization header is sent).
# The domains below are placeholders, not default targets.
#SPAGO_LLM_BASE_URL=https://provider.example/v1
#SPAGO_LLM_API_KEY=
#SPAGO_LLM_MODEL=your-model-id

# Host interface the app port binds to. Keep the loopback default when a paid
# provider key is configured; open explicitly behind your own authentication.
#SPAGO_APP_BIND=127.0.0.1
#SPAGO_APP_PORT=8000
