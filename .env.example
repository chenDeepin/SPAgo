# SPAgo local environment configuration.
# Copy to .env and adjust as needed. Never commit real secrets.

# --- PostgreSQL (docker compose wires these into the db service) ---
POSTGRES_USER=spago
POSTGRES_PASSWORD=spago
POSTGRES_DB=spago
# Port exposed on the host by the db container.
SPAGO_DB_PORT=5432
# Host interface the db port binds to. Loopback by default: the database is a
# private part of the app stack, not a LAN service. Exposing it (0.0.0.0)
# requires changing the demo POSTGRES_PASSWORD first; see docs/runbook.md.
#SPAGO_DB_BIND=127.0.0.1

# --- Backend (app container; defaults are already correct for compose) ---
# demo (default) loads the synthetic fixture at startup; none applies migrations
# only — real-data deployments import SureChEMBL packages instead (docs/runbook.md).
#SPAGO_SEED_MODE=demo
# SQLAlchemy URL used inside the app container.
SPAGO_DATABASE_URL=postgresql+psycopg://spago:spago@db:5432/spago
# Directory holding fixture Parquet files (baked into the app image).
SPAGO_FIXTURE_DIR=/app/data/fixtures
# Directory holding versioned SQL migrations (baked into the app image).
SPAGO_MIGRATIONS_DIR=/app/migrations
# Directory for cached molecule depictions (mounted as a volume).
SPAGO_DEPICTION_CACHE_DIR=/app/data/cache/depictions
SPAGO_DEFAULT_PAGE_SIZE=100
SPAGO_MAX_PAGE_SIZE=500
# Comma-separated CORS origins for local development.
SPAGO_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Frontend: base URL of the backend API (build-time default "/api/v1" via Vite proxy in dev).
VITE_API_BASE_URL=/api/v1

# --- LLM endpoint (optional; all three unset → offline extractive summaries) ---
# The base URL carries the FULL API prefix (usually including the version
# segment); SPAgo appends exactly /chat/completions. Plain http is only
# accepted for loopback/private-network endpoints. Leave SPAGO_LLM_API_KEY
# empty for unauthenticated local endpoints (no Authorization header is sent).
# The domains below are placeholders, not default targets.
#SPAGO_LLM_BASE_URL=https://provider.example/v1
#SPAGO_LLM_API_KEY=
#SPAGO_LLM_MODEL=your-model-id
# Opt-in request parameter for endpoints that document it (DeepSeek-style
# `thinking` object). Off by default: stricter OpenAI-compatible endpoints
# reject unknown parameters. Set true for models that reason by default and
# consume the whole output budget before writing any content.
#SPAGO_LLM_DISABLE_THINKING=false
# Opt-in OpenAI-standard JSON decoding mode (`response_format`). Use it when the
# model occasionally returns malformed JSON; strictly limited endpoints reject
# the parameter, so it is off by default.
#SPAGO_LLM_JSON_MODE=false

# Host interface the app port binds to. Keep the loopback default when a paid
# provider key is configured; open explicitly behind your own authentication.
#SPAGO_APP_BIND=127.0.0.1
#SPAGO_APP_PORT=8000

# --- Hosted access (ONLINE-03/04; see docs/adr/0002-auth-and-ownership.md) ---
# disabled (default) is the local single-user product: one implicit identity, no
# sign-in, and existing rows stay unattached to any account. "required" is the
# hosted mode: every workspace request needs a valid session and anonymous
# callers fail closed. Read docs/runbook.md §H1-H9 before setting this.
SPAGO_AUTH_MODE=disabled
# Set true whenever the deployment is served over HTTPS (session cookies).
#SPAGO_COOKIE_SECURE=true
# Session and invitation lifetimes.
#SPAGO_SESSION_TTL_HOURS=12
#SPAGO_INVITATION_TTL_HOURS=72
# Additional browser origin allowed to call the API (the hosted UI is same-origin).
#SPAGO_CORS_ORIGINS_EXTRA=https://spago.example.org

# --- Model usage bounds (ONLINE-04) ---
# Both limits are enforced in the service layer before a paid call is sent; 0
# disables a limit and must be a deliberate choice. Unset price => the report
# gives tokens only and never invents a currency figure.
#SPAGO_LLM_USER_TOKEN_LIMIT=200000
#SPAGO_LLM_DEPLOYMENT_TOKEN_LIMIT=2000000
#SPAGO_LLM_QUOTA_WINDOW=month
#SPAGO_LLM_RESERVE_TOKENS=2000
#SPAGO_LLM_PRICE_PER_MILLION_TOKENS=
#SPAGO_LLM_PRICE_CURRENCY=USD
